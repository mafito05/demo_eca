# =============================================================================
#  Copiar a `.env` y ajustar. NUNCA commitear `.env`.
#  Generar las dos claves con:
#    python -c "import secrets; print(secrets.token_urlsafe(48))"          -> JWT_SECRET_KEY
#    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                                                                          -> SECRET_ENCRYPTION_KEY
# =============================================================================

ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=demoeca
POSTGRES_PASSWORD=demoeca
POSTGRES_DB=demoeca
POSTGRES_PORT=5432
# En local (fuera de Docker) usar localhost; docker-compose la sobrescribe.
DATABASE_URL=postgresql+asyncpg://demoeca:demoeca@localhost:5432/demoeca

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MinIO -------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_VIDEO=demoeca-video
MINIO_BUCKET_DOCS=demoeca-docs
MINIO_BUCKET_PUBLIC=demoeca-public
# Vida de las URLs pre-firmadas (subida de video, segmentos HLS, certificados).
MINIO_PRESIGN_TTL_SECONDS=3600

# --- Seguridad ---------------------------------------------------------------
JWT_SECRET_KEY=cambiame-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# Clave Fernet independiente para cifrar API keys de proveedores y secretos de tools (D-008).
SECRET_ENCRYPTION_KEY=cambiame-por-una-clave-fernet-valida

# Bypass de login para la demo (D-003). En produccion: false.
AUTH_BYPASS_ENABLED=true
# Bajo example.com (RFC 2606). Un TLD .local o .test lo rechaza EmailStr y el login da 422.
DEMO_USER_EMAIL=demo@demoeca.example.com

# --- CORS --------------------------------------------------------------------
# Angular en 4200. Flutter no necesita CORS (no es un navegador).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Deep linking (D-004 supuestos) -----------------------------------------
DEEPLINK_DOMAIN=demoeca.example.com
DEEPLINK_SCHEME=demoeca
ANDROID_PACKAGE_NAME=com.demoeca.demoeca_app
IOS_BUNDLE_ID=com.demoeca.demoecaApp

# --- Embeddings: FIJOS por instalación (D-005) ------------------------------
# Cambiar cualquiera de estos tres invalida el corpus vectorizado existente.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# La key de embeddings vive en .env, no en la BD: es infraestructura, no
# configuración editable por el admin.
EMBEDDING_API_KEY=

# --- RAG ---------------------------------------------------------------------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
# Distancia coseno máxima aceptada (0 = idéntico, 2 = opuesto). Por encima se descarta
# el chunk: es mejor decir "no lo sé" que citar un fragmento irrelevante.
RAG_MAX_DISTANCE=0.65

# --- Agente ------------------------------------------------------------------
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_MAX_TOOL_ITERATIONS=5
AGENT_RATE_LIMIT_PER_MINUTE=20

# --- Tools HTTP dinámicas (D-007) -------------------------------------------
# Allowlist de hosts invocables. Vacío = ninguna tool externa puede ejecutarse.
TOOL_ALLOWED_HOSTS=
TOOL_TIMEOUT_SECONDS=15
TOOL_MAX_RESPONSE_BYTES=131072

# --- Video / HLS -------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
HLS_SEGMENT_SECONDS=6
HLS_RENDITIONS=360p,720p

# --- Anadidas para el modulo LMS ---------------------------------------------
# Host con el que se FIRMAN las URLs para clientes externos. Dentro de Docker el backend usa
# minio:9000, pero una URL firmada con ese host no la resuelve el movil ni el navegador, y la
# firma cubre el host (no se puede reescribir despues).
MINIO_PUBLIC_ENDPOINT=localhost:9000
# Vida del token de reproduccion HLS. Debe sobrevivir a la leccion mas larga.
HLS_TOKEN_TTL_SECONDS=7200
# Porcentaje visto a partir del cual la leccion se marca completada.
LESSON_COMPLETION_PERCENT=90
